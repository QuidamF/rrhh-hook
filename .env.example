# --- Server ---
PORT=5000
API_KEY=your_secret_api_key_here

# --- Dominio o Subdominio Público (ngrok, Cloudflare Tunnel o dominio propio) ---
# Al configurarlo, el Webhook se auto-configura hacia https://<WEBHOOK_DOMAIN>/webhook
# y unifica el servicio de archivos multimedia hacia https://<WEBHOOK_DOMAIN>/media
WEBHOOK_DOMAIN=tu-subdominio-o-ngrok.dev

# --- Meta API ---
# Create these at developers.facebook.com
VERIFY_TOKEN=your_verify_token
WHATSAPP_TOKEN=your_whatsapp_access_token
PAGE_ACCESS_TOKEN=your_messenger_page_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
FACEBOOK_PAGE_ID=your_page_id
APP_SECRET=your_app_secret

# --- Telegram API ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_WEBHOOK_URL es opcional si ya configuraste WEBHOOK_DOMAIN:
TELEGRAM_WEBHOOK_URL=
TELEGRAM_SECRET_TOKEN=your_telegram_secret_token


# --- MongoDB ---
# Default for Docker Compose is 'mongo'
MONGO_URI=mongodb://mongo:27017/omnicanal
DATABASE_NAME=omnicanal

# --- Redis (Streams and Locking) ---
# When running in Docker, use 'redis' as host
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL (Core persistence) ---
# Default credentials used in docker-compose.yml
PG_USER=admin
PG_PASSWORD=admin123
PG_DB=omnicanal
PG_URL=postgresql://admin:admin123@postgres:5432/omnicanal

# --- AI Models & LLM Providers (OpenAI / Gemini / Ollama) ---
LLM_PROVIDER=openai # openai | gemini | ollama
USE_OPENAI=true
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

USE_GEMINI=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma2:9b
OLLAMA_MODEL_EDITOR=qwen2.5:7b

# --- AI UX ---
ENABLE_TYPING_DELAY=true

# --- Media Storage ---
MEDIA_ROOT=media
MEDIA_URL_BASE=https://omnichanel.jpm-dev.mx/media
