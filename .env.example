# --- Server ---
PORT=5000
API_KEY=your_secret_api_key_here

# --- Meta API ---
# Create these at developers.facebook.com
VERIFY_TOKEN=your_verify_token
WHATSAPP_TOKEN=your_whatsapp_access_token
PAGE_ACCESS_TOKEN=your_messenger_page_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
FACEBOOK_PAGE_ID=your_page_id
APP_SECRET=your_app_secret

# --- Telegram API ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_SECRET_TOKEN=your_telegram_secret_token

# --- MongoDB ---
# Default for Docker Compose is 'mongo'
MONGO_URI=mongodb://mongo:27017/omnicanal
DATABASE_NAME=omnicanal

# --- Redis (Streams and Locking) ---
# When running in Docker, use 'redis' as host
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL (Core persistence) ---
# Default credentials used in docker-compose.yml
PG_USER=admin
PG_PASSWORD=admin123
PG_DB=omnicanal
PG_URL=postgresql://admin:admin123@postgres:5432/omnicanal

# --- AI Models ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma2:9b
OLLAMA_MODEL_EDITOR=qwen2.5:7b
USE_GEMINI=true
GEMINI_API_KEY=your_gemini_api_key_here

# --- AI UX ---
ENABLE_TYPING_DELAY=true

# --- Media Storage ---
MEDIA_ROOT=media
MEDIA_URL_BASE=https://omnichanel.jpm-dev.mx/media
